# Supabase project (create at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # browser-safe, RLS-constrained
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # SERVER ONLY — never NEXT_PUBLIC_

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...      # public key id only

# Python ML scripts read this directly
DATABASE_URL=postgresql://...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mocked provider adapters — see lib/adapters/
SMS_PROVIDER=mock
KYC_PROVIDER=mock
INSURANCE_PROVIDER=mock
